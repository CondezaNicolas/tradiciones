# Database � Turso (production) or local file (development)
# Local dev:    file:./data/tradiciones.sqlite
# Production:   libsql://your-db-name.turso.io
DATABASE_URL=file:./data/tradiciones.sqlite
# Only needed for remote Turso (leave empty for local)
DATABASE_AUTH_TOKEN=

# Auth — REQUIRED. Random string of at least 16 chars (use e.g.
# `openssl rand -base64 32`). The app refuses to start / verify sessions
# without it; there is no insecure fallback.
JWT_SECRET=

# Seed admin (used by `npm run db:seed`). If ADMIN_PASSWORD is omitted a
# strong random password is generated and printed once. Never ship a
# known/default password.
# ADMIN_EMAIL=admin@tradiciones.cl
# ADMIN_PASSWORD=

# Vercel Cron — REQUIRED for /api/cron/keep-alive (endpoint refuses to run
# without it). Vercel injects `Authorization: Bearer $CRON_SECRET`.
# CRON_SECRET=

# SEO — canonical site URL (no trailing slash). Drives sitemap, robots,
# Open Graph and canonical tags. Defaults to https://tradiciones.vercel.app
# NEXT_PUBLIC_SITE_URL=https://tradiciones.vercel.app

# Storage � "local" for dev, "supabase" for production
STORAGE_PROVIDER=local

# Supabase (required when STORAGE_PROVIDER=supabase)
# NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_STORAGE_BUCKET=revistas
