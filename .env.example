# Database — Turso (production) or local file (development)
# Local dev:    file:./data/tradiciones.sqlite
# Production:   libsql://your-db-name.turso.io
DATABASE_URL=file:./data/tradiciones.sqlite
# Only needed for remote Turso (leave empty for local)
DATABASE_AUTH_TOKEN=

# Auth
JWT_SECRET=change-me-in-production

# Storage — "local" for dev, "supabase" for production
STORAGE_PROVIDER=local

# Supabase (required when STORAGE_PROVIDER=supabase)
# NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_STORAGE_BUCKET=revistas
